                <mxCell id="t100" value="&lt;b&gt;Key distinction:&lt;/b&gt; image uploads can use the optional GCP Cloud Run accelerator, while video uploads stay on AWS Lambda and run frame sampling plus local inference before writing the final DynamoDB record." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=15;" parent="1" vertex="1">
