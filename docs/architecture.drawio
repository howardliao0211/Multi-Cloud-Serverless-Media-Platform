                <mxCell id="e57" value="23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;" parent="1" source="v26" target="v27" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e58" value="ID token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#674ea7;fontSize=12;dashed=1;dashPattern=6 4;" parent="1" source="v16" target="v20" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e59" value="verify HMAC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#674ea7;fontSize=12;dashed=1;dashPattern=6 4;" parent="1" source="v21" target="v22" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e60" value="container image" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#674ea7;fontSize=12;dashed=1;dashPattern=6 4;" parent="1" source="v23" target="v22" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="v61" value="&lt;b&gt;Upload-focused data-flow legend&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;collapsible=0;container=1;recursiveResize=0;fillColor=#f8f9fa;strokeColor=#999999;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1340" width="2295" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="t62" value="&lt;b&gt;1&lt;/b&gt; User signs in with Cognito. &lt;b&gt;2–3&lt;/b&gt; Frontend calls API Gateway and get_signed_url Lambda. &lt;b&gt;4&lt;/b&gt; Lambda writes a pending MediaRecord. &lt;b&gt;5–6&lt;/b&gt; Frontend receives a presigned S3 PUT URL and uploads the image/video directly to S3. &lt;b&gt;7–8&lt;/b&gt; S3 prefix notification invokes tag_image or tag_video. &lt;b&gt;9–10&lt;/b&gt; Processing Lambdas read metadata, update status, and create thumbnails. &lt;b&gt;11–13&lt;/b&gt; Image processing may call GCP Cloud Run through signed request; if unavailable it falls back to local AWS inference. Video remains on AWS Lambda. &lt;b&gt;14–15&lt;/b&gt; Lambda writes tags, detections, thumbnail, model metadata, and ready/failed status to DynamoDB. &lt;b&gt;16–19&lt;/b&gt; Frontend polls status. &lt;b&gt;20–23&lt;/b&gt; DynamoDB Streams trigger tag notifications for public ready media through SNS email filters." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="65" y="1380" width="2240" height="95" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
