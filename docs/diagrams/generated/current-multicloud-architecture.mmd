flowchart LR
  user[User] --> frontend[React frontend]
  frontend --> apigw[Amazon API Gateway]
  apigw --> cognito[Amazon Cognito]

  subgraph aws[AWS current application]
    apigw --> api_lambdas[Lambda API functions]
    api_lambdas --> media_table[DynamoDB media table]
    api_lambdas --> subscription_table[DynamoDB subscription table]
    api_lambdas --> s3[S3 media bucket]
    api_lambdas --> sns[SNS notifications]
    api_lambdas --> logs[CloudWatch logs]

    s3 --> images_prefix[images/]
    s3 --> videos_prefix[videos/]
    s3 --> thumbnails_prefix[thumbnails/]
    s3 --> models_prefix[models/model.pt and models/mdv5a.pt]
    s3 --> images_v2[images-v2/]
    s3 --> videos_v2[videos-v2/]

    images_prefix -- S3 ObjectCreated trigger --> tag_image[tag_image Lambda v1]
    videos_prefix -- S3 ObjectCreated trigger --> tag_video[tag_video Lambda v1]
    tag_image --> media_table
    tag_video --> media_table
    tag_image --> logs
    tag_video --> logs

    images_v2 -. manual invoke today .-> media_ingest_v2[media_ingest_v2 Lambda v2]
    videos_v2 -. manual invoke today .-> media_ingest_v2
    images_v2 -. future S3 notification .-> media_ingest_v2
    videos_v2 -. future S3 notification .-> media_ingest_v2
    media_ingest_v2 --> thumbnails_prefix
    media_ingest_v2 --> process_ml_result_v2[process_ml_result_v2 Lambda]
    process_ml_result_v2 --> media_table
    media_ingest_v2 --> logs
    process_ml_result_v2 --> logs

    media_table -- DynamoDB Stream --> publish_tags[publish_tags Lambda]
    publish_tags --> sns
  end

  subgraph security[Cross-cloud security]
    wif[Workload Identity Federation]
    idtoken[Google ID token]
    hmac[HMAC shared secret]
    secret_manager[Secret Manager / Secrets Manager]
  end

  subgraph gcp[GCP ML processing]
    cloud_run[Cloud Run ML processor]
    ml[AI/ML inference]
    artifact_registry[Artifact Registry deployment images]
  end

  media_ingest_v2 -- presigned input_url --> cloud_run
  media_ingest_v2 -- presigned model_urls --> cloud_run
  models_prefix -- temporary HTTPS model download --> cloud_run
  media_ingest_v2 -- WIF impersonation --> wif
  wif --> idtoken
  idtoken -- Authorization bearer token --> cloud_run
  media_ingest_v2 -- X-Signature and X-Timestamp --> hmac
  secret_manager --> hmac
  hmac -- verified by /process-media --> cloud_run
  cloud_run --> ml
  cloud_run -- tag_counts and optional frames --> media_ingest_v2
  artifact_registry -. deploy script only .-> cloud_run

